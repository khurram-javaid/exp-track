NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb+srv://<db-user>:<db-password>@<cluster-host>/trackio?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
FRONTEND_URLS=http://localhost:5173,http://localhost:4173,http://127.0.0.1:5173,http://127.0.0.1:4173
COOKIE_SAME_SITE=lax
# Set COOKIE_SAME_SITE=none for a frontend and API on different sites; production requires HTTPS.
# COOKIE_DOMAIN=.example.com
# TRUST_PROXY_HOPS=1
